# CampusOS Root Environment Configuration
# Copy this to server/.env and fill in your real credentials
NODE_ENV=development
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/campusos?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/campusos?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=super_secret_campusos_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
